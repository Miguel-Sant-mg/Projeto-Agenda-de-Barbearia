# ==============================================================================
# CONFIGURAÇÕES DO SERVIDOR WEB - BARBEARIA ARTE DE FAVELA
# ==============================================================================

# Endereço de escuta do servidor (0.0.0.0 permite acesso local e de outros dispositivos na rede Wi-Fi)
HOST=0.0.0.0

# Porta do servidor web (Padrão: 5000)
PORT=5000

# Ambiente de execução: development (desenvolvimento) ou production (produção)
FLASK_ENV=development

# Ativação do modo Debug (true / false). Desative em produção!
FLASK_DEBUG=true

# Chave Secreta para assinatura segura de cookies de sessão
# Em produção, gere uma chave forte (ex: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=arte-de-favela-chave-segura-2026-barbearia-altere-em-producao

# Motor do Servidor: 'flask' (servidor de desenvolvimento) ou 'waitress' (servidor WSGI estável e seguro para rede)
SERVER_ENGINE=flask
